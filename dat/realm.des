#	The Merozalghi Realm: the fill level, the town of Skunj and the
#	Citadel of Miralt.
#
#	Map letters used here (see lev_main.c): 'a' is an acid pool and
#	'w' shallow water.
#

#	The "fill" level for the realm: a cave with rivers of acid, and
#	merozalghi, shoggoths, ghasts and gugs about.
#
LEVEL: "merofill"
FLAGS:mazelevel,noflip
INIT_MAP: mines, '.' , ' ' , true , true , random , true
MON_GENERATION:40%, (4,"lesser merozalghu"), (3,"merozalghu"), (2,"lesser merozalghu soldier"), (1,"merozalghu captain"), (2,"merozalghu warlock"), (2,"merozalghu shaman"), (2,"merozalghu necromancer"), (2,"merozalghu cultist"), (1,"accursed merozalghu"), (3,"ghast"), (2,"gug"), (1,"shoggoth"), (1,"giant shoggoth")
NOMAP
#
# rivers of acid: one, or two a half of the time, running across the cave
$ax = 6 + 1d28
$bx = 42 + 1d32
TERRAIN: grow(east, randline ($ax,1)-($bx,19),2), 'a'
IF [50%] {
  $ly = 3 + 1d6
  $ry = 10 + 1d8
  TERRAIN: grow(south, randline (1,$ly)-(76,$ry),2), 'a'
}
#
STAIR: random, up
STAIR: random, down
#
LOOP [3] {
  OBJECT: ')', random
}
LOOP [2] {
  OBJECT: '[', random
}
LOOP [4] {
  OBJECT: '?', random
}
OBJECT: '/', random
#
LOOP [2 + 1d3] {
  MONSTER: ('z', "lesser merozalghu"), random
}
LOOP [1 + 1d2] {
  MONSTER: ('z', "merozalghu"), random
}
MONSTER[50%]: ('z', "accursed merozalghu"), random
MONSTER[50%]: ('z', "lesser merozalghu soldier"), random
MONSTER[40%]: ('z', "merozalghu warlock"), random
MONSTER[40%]: ('z', "merozalghu shaman"), random
MONSTER[30%]: ('z', "merozalghu necromancer"), random
MONSTER[40%]: ('z', "merozalghu cultist"), random
MONSTER[35%]: ('z', "merozalghu captain"), random
MONSTER[40%]: ('P', "shoggoth"), random
MONSTER[20%]: ('P', "giant shoggoth"), random
LOOP [1d3] {
  MONSTER: ('z', "ghast"), random
}
MONSTER[60%]: ('z', "gug"), random
LOOP [4 + 1d4] {
  MONSTER: random, random
}
#
LOOP [4 + 1d5] {
  TRAP: random, random
}

# Skunj
#
# The one town of the realm: a cave town with two general stores and one
# other shop, a temple of the chaotic, a fountain or two and a pair of cages
# (iron bars with a locked door) holding soldiers, who are usually peaceful.
#
LEVEL: "skunj"
FLAGS:mazelevel,noflip
INIT_MAP:mines,'.',' ',true,true,lit,true
MON_GENERATION:40%, (4,"lesser merozalghu"), (3,"merozalghu"), (2,"lesser merozalghu soldier"), (1,"merozalghu captain"), (2,"merozalghu warlock"), (2,"merozalghu shaman"), (2,"merozalghu necromancer"), (2,"merozalghu cultist"), (1,"accursed merozalghu"), (3,"ghast"), (2,"gug"), (1,"shoggoth"), (1,"giant shoggoth")
# acid rivers in the caves beyond either end of the town
TERRAIN: grow(randline (4,0)-(9,20),4), 'a'
TERRAIN: grow(randline (71,0)-(76,20),4), 'a'
GEOMETRY:center,center
MAP
.......................................
..---------..FFF.......FFF..---------..
..|.......|..F.F.......F.F..|.......|..
..|.......|..F+F.......F+F..|.......|..
..|.......|.................|.......|..
..|.......|.................|.......|..
..----+----.................----+----..
.......................................
.......................................
.......................................
..----+----...-----+-----...----+----..
..|.......|...|.........|...|.......|..
..|.......|...|.........|...|.......|..
..|.......|...|.........|...|.......|..
..|.......|...|.........|...|.......|..
..---------...-----------...---------..
.......................................
ENDMAP

REGION:(00,00,38,16),lit,"ordinary"
TELEPORT_REGION:levregion(13,01,19,19),levregion(20,00,70,19)
STAIR:levregion(13,03,19,19),(00,00,38,16),up
STAIR:levregion(61,03,69,19),(00,00,38,16),down

FOUNTAIN:(19,08)
FOUNTAIN:(08,08)
FOUNTAIN:(30,08)

# the two general stores
REGION:(03,02,09,05),lit,"shop"
DOOR:closed,(06,06)
IF [33%] {
  REGION:(29,02,35,05),lit,"mimic shop"
} ELSE {
  REGION:(29,02,35,05),lit,"shop"
}
DOOR:closed,(32,06)

# and a shop of some other kind
DOOR:closed,(06,10)
SWITCH [1d9] {
  CASE 1:
    REGION:(03,11,09,14),lit,"tool shop"
    BREAK
  CASE 2:
    REGION:(03,11,09,14),lit,"candle shop"
    BREAK
  CASE 3:
    REGION:(03,11,09,14),lit,"food shop"
    BREAK
  CASE 4:
    REGION:(03,11,09,14),lit,"weapon shop"
    BREAK
  CASE 5:
    REGION:(03,11,09,14),lit,"armor shop"
    BREAK
  CASE 6:
    REGION:(03,11,09,14),lit,"scroll shop"
    BREAK
  CASE 7:
    REGION:(03,11,09,14),lit,"wand shop"
    BREAK
}

# the temple
REGION:(15,11,23,14),lit,"temple"
DOOR:closed,(19,10)
ALTAR:(19,12),chaos,shrine

# a plain house
REGION:(29,11,35,14),lit,"ordinary"
DOOR:closed,(32,10)

# the cages
DOOR:locked,(14,03)
DOOR:locked,(24,03)
IF [90%] {
  MONSTER: ('@', "soldier"), (14,02), peaceful
} ELSE {
  MONSTER: ('@', "soldier"), (14,02), hostile
}
IF [90%] {
  MONSTER: ('@', "soldier"), (24,02), peaceful
} ELSE {
  MONSTER: ('@', "soldier"), (24,02), hostile
}

#
LOOP [3] {
  OBJECT: ')', random
}
LOOP [2] {
  OBJECT: '[', random
}
LOOP [4] {
  OBJECT: '?', random
}
OBJECT: '/', random
#
LOOP [1 + 1d3] {
  MONSTER: ('z', "lesser merozalghu"), random
}
MONSTER: ('z', "merozalghu"), random
MONSTER[50%]: ('z', "lesser merozalghu soldier"), random
MONSTER[35%]: ('z', "merozalghu captain"), random
MONSTER[35%]: ('z', "merozalghu warlock"), random
MONSTER[35%]: ('z', "merozalghu shaman"), random
MONSTER[25%]: ('z', "merozalghu necromancer"), random
MONSTER[35%]: ('z', "merozalghu cultist"), random
MONSTER[30%]: ('z', "accursed merozalghu"), random
MONSTER[30%]: ('P', "shoggoth"), random
MONSTER[15%]: ('P', "giant shoggoth"), random
MONSTER: ('z', "ghast"), random
MONSTER[50%]: ('z', "gug"), random
LOOP [3 + 1d3] {
  MONSTER: random, random
}
LOOP [3 + 1d3] {
  TRAP: random, random
}

# Citadel Miralt
#
# The bottom of the realm: a walled citadel with a throne hall in the middle
# and a locked chest in each of the side rooms.  Miralt sits on his throne.
#
LEVEL: "citadel"
FLAGS:mazelevel,noflip
INIT_MAP:solidfill,' '
MON_GENERATION:40%, (4,"lesser merozalghu"), (3,"merozalghu"), (2,"lesser merozalghu soldier"), (1,"merozalghu captain"), (2,"merozalghu warlock"), (2,"merozalghu shaman"), (2,"merozalghu necromancer"), (2,"merozalghu cultist"), (1,"accursed merozalghu"), (3,"ghast"), (2,"gug"), (1,"shoggoth"), (1,"giant shoggoth")
GEOMETRY:center,center
MAP
...............................................
...............................................
.....------------------+------------------.....
.....|...................................|.....
.....|......-----------+-----------......|.....
..aa.|-----.|.....................|.-----|.....
..aa.||...|.|.....................|.|...||.....
.....||...|.|.....................|.|...||.....
.....||...+.|.....................|.+...||.....
.....||...|.|.....................|.|...||.....
.....||...|.|.....................|.|...||.....
.....|-----.|.....................|.-----|.....
.....|......|.....................|......|.aa..
.....|......|.....................|......|.aa..
.....|......-----------+-----------......|.....
.....|...................................|.....
.....------------------+------------------.....
...............................................
...............................................
ENDMAP

REGION:(00,00,46,18),lit,"ordinary"
NON_DIGGABLE:(05,02,41,16)

# the gates and the doors to the throne hall and side rooms
DOOR:closed,(23,02)
DOOR:closed,(23,16)
DOOR:closed,(23,04)
DOOR:closed,(23,14)
DOOR:closed,(10,08)
DOOR:closed,(36,08)

$place = { (02,09),(44,09) }
SHUFFLE:$place
STAIR:$place[0],up

# Miralt, on his throne
OBJECT:('\',"throne"),(23,09)
MONSTER:('z',"Miralt"),(23,09),hostile

# the guard of honor
