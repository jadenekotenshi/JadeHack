# a dozen more about the citadel
$inside = selection: fillrect(13,05,33,13) & fillrect(06,03,40,03) & fillrect(06,15,40,15) & fillrect(11,03,11,15) & fillrect(35,03,35,15)
LOOP [12] {
  SWITCH [1d9] {
    CASE 1:
      MONSTER: ('z', "lesser merozalghu"), rndcoord($inside), hostile
      BREAK
    CASE 2:
      MONSTER: ('z', "lesser merozalghu soldier"), rndcoord($inside), hostile
      BREAK
    CASE 3:
      MONSTER: ('z', "merozalghu"), rndcoord($inside), hostile
      BREAK
    CASE 4:
      MONSTER: ('z', "merozalghu captain"), rndcoord($inside), hostile
      BREAK
    CASE 5:
      MONSTER: ('z', "merozalghu warlock"), rndcoord($inside), hostile
      BREAK
    CASE 6:
      MONSTER: ('z', "merozalghu shaman"), rndcoord($inside), hostile
      BREAK
    CASE 7:
      MONSTER: ('z', "merozalghu necromancer"), rndcoord($inside), hostile
      BREAK
    CASE 8:
      MONSTER: ('z', "merozalghu cultist"), rndcoord($inside), hostile
      BREAK
    CASE 9:
      MONSTER: ('z', "accursed merozalghu"), rndcoord($inside), hostile
      BREAK
  }
}

# a chest in each side room
CONTAINER:('(',"chest"),(08,08),locked {
  OBJECT: '/'
  OBJECT: ('!', "gain level"), cursed
  OBJECT: ('?', "shocking grasp"), blessed
  OBJECT: '%'
  OBJECT: '%'
  OBJECT: '%'
  OBJECT[50%]: (')', "silver arrow"), blessed, 1, quantity:1d20
}
CONTAINER:('(',"chest"),(38,08),locked {
  OBJECT: '/'
  OBJECT: ('!', "gain level"), cursed
  OBJECT: ('?', "shocking grasp"), blessed
  OBJECT: '%'
  OBJECT: '%'
