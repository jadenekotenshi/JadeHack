#
#	The "start" level for the quest.
#
#	Here you meet your (besieged) class leader, Medea,
#	and receive your quest assignment.
#
LEVEL: "Wit-strt"
FLAGS: noteleport,hardfloor,arboreal,mazelevel
INIT_MAP:mines,'.','.',true,true,lit,false
REPLACE_TERRAIN:(0,0,76,19),'.', 'T', 5%
MON_GENERATION:86%, (64,"witch-hunter"), (16,"wolf"), (16,"warg"), (4,"winter wolf")
GEOMETRY:(0,1)
#1234567890123456789012345678901234567890123456789012345678901234567890
MAP
                                       xx
   ...................................  x
  ..                                 ..  
 ..  ...............F...............  .. 
 .  ..             .F.             ..  . 
 . ..  .............F.............  .. . 
 . .  ..                         ..  . . 
 . . ..  .......................  .. ... 
 . . .  ..                     ..  .     
 ... . ..  .|..................... ......
 FFF . .  ..S..................          
 ... . ..  .|.................  .... ... 
 . . .  ..                     ..  . . . 
 . . ..  .......................  .. . . 
 . .  ..                         ..  . . 
 . ..  .............F.............  .. . 
 .  ..             .F.             ..  . 
 ..  ...............F...............  .. 
  ..                                 ..  
   ...................................  x
                                       xx
ENDMAP
# Dungeon Description
REGION:(00,00,40,20),lit,"ordinary"
# Stairs
STAIR:(10,10),down
# Portal arrival point; just about anywhere on the right hand side of the map
BRANCH:levregion(51,2,77,18),(0,0,40,20)
# Medea
MONSTER:('@',"Medea"),(20,10) {
  OBJECT:('[',"robe")
  OBJECT:(')',"athame")
  OBJECT:('!',"extra healing")
  OBJECT:('!',"gain energy")
}
# The cauldron of Medea
OBJECT:('(',"cauldron"),(20,10)
# Guards for the audience chamber
MONSTER:('@',"coven sister"),(19,09) {
  OBJECT[25%]:('[',"robe")
  OBJECT[50%]:'!'
  OBJECT[15%]:')'
}
MONSTER:('@',"coven sister"),(20,09) {
  OBJECT[25%]:('[',"robe")
  OBJECT[50%]:'!'
  OBJECT[15%]:')'
}
MONSTER:('@',"coven sister"),(21,09) {
  OBJECT[25%]:('[',"robe")
  OBJECT[50%]:'!'
  OBJECT[15%]:')'
}
MONSTER:('@',"coven sister"),(19,10) {
  OBJECT[25%]:('[',"robe")
  OBJECT[15%]:')'
}
MONSTER:('@',"coven sister"),(21,10) {
  OBJECT[25%]:('[',"robe")
  OBJECT[15%]:')'
}
MONSTER:('@',"coven sister"),(19,11) {
  OBJECT[25%]:('[',"robe")
  OBJECT[15%]:')'
}
MONSTER:('@',"coven sister"),(20,11) {
  OBJECT[25%]:('[',"robe")
  OBJECT[15%]:')'
}
MONSTER:('@',"coven sister"),(21,11) {
  OBJECT[25%]:('[',"robe")
  OBJECT[15%]:')'
}
# Non diggable walls
NON_DIGGABLE:(00,00,40,20)
# Traps
TRAP:"arrow",(30,09)
TRAP:"arrow",(30,10)
TRAP:"pit",(40,09)
TRAP:"spiked pit",random
TRAP:"bear",random
TRAP:"bear",random
# Monsters on siege duty.
MONSTER: ('d',"warg"),(33,09),hostile,asleep
MONSTER: ('@',"witch-hunter"),(19,03),hostile
MONSTER: ('@',"witch-hunter"),(19,04),hostile
MONSTER: ('@',"witch-hunter"),(19,05),hostile
MONSTER: ('@',"witch-hunter"),(21,03),hostile
MONSTER: ('@',"witch-hunter"),(21,04),hostile
MONSTER: ('@',"witch-hunter"),(21,05),hostile
MONSTER: ('@',"witch-hunter"),(01,09),hostile
MONSTER: ('@',"witch-hunter"),(02,09),hostile
MONSTER: ('@',"witch-hunter"),(03,09),hostile
MONSTER: ('@',"witch-hunter"),(01,11),hostile
MONSTER: ('@',"witch-hunter"),(02,11),hostile
MONSTER: ('@',"witch-hunter"),(03,11),hostile
MONSTER: ('@',"witch-hunter"),(19,15),hostile
MONSTER: ('@',"witch-hunter"),(19,16),hostile
MONSTER: ('@',"witch-hunter"),(19,17),hostile
MONSTER: ('@',"witch-hunter"),(21,15),hostile
MONSTER: ('@',"witch-hunter"),(21,16),hostile
MONSTER: ('@',"witch-hunter"),(21,17),hostile
LOOP [4 + 2d5] {
  MONSTER: ('@',"witch-hunter"),random,hostile
}
MONSTER: ('d',"wolf"),random,hostile
MONSTER: ('d',"wolf"),random,hostile


#
#	The "locate" level for the quest.
#
#	Here you have to find your way through the Witchwood to go
#	further towards your assigned quest.
#

LEVEL: "Wit-loca"
FLAGS: hardfloor,mazelevel
INIT_MAP:solidfill,' '
MON_GENERATION:86%, (64,"witch-hunter"), (16,"wolf"), (16,"warg"), (4,"winter wolf")
GEOMETRY:center,center
