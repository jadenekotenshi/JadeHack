WALLIFY

#
#	The "fill" levels for the quest.
#
#	These levels are used to fill out any levels not occupied by specific
#	levels as defined above. "fila" is the upper filler, between the
#	start and locate levels, and "filb" the lower between the locate
#	and goal levels.
#

LEVEL: "Wit-fila"
FLAGS:mazelevel,noflip
INIT_MAP: mines, '.' , 'T', true, true, random, true
MON_GENERATION:86%, (64,"witch-hunter"), (16,"wolf"), (16,"warg"), (4,"winter wolf")
NOMAP
#
STAIR: random, up
STAIR: random, down
#
LOOP [5 + 1d5] {
  OBJECT: random, random
}
#
LOOP [3 + 1d4] {
  TRAP: random, random
}
#
LOOP [2 + 1d4] {
  MONSTER: ('@',"witch-hunter"), random, hostile
  MONSTER: ('@',"witch-hunter"), random, hostile
}
MONSTER: ('@',"witch-hunter"), random, hostile
MONSTER: ('d',"wolf"), random, hostile

LEVEL: "Wit-filb"
FLAGS:mazelevel,noflip
INIT_MAP: mines, '.' , ' ', true, true, random, true
MON_GENERATION:86%, (64,"witch-hunter"), (16,"wolf"), (16,"warg"), (4,"winter wolf")
NOMAP
#
STAIR: random, up
STAIR: random, down
#
LOOP [9 + 1d5] {
  OBJECT: random, random
}
#
LOOP [2 + 1d5] {
  TRAP: random, random
}
#
LOOP [3 + 1d5] {
  MONSTER: ('@',"witch-hunter"), random, hostile
  MONSTER: ('@',"witch-hunter"), random, hostile
  MONSTER: ('d',"wolf"), random, hostile
}

